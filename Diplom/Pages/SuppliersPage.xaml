<Page x:Class="Diplom.Pages.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom.Pages"
      xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"  
      d:DesignHeight="750" d:DesignWidth="1175"
      Title="SuppliersPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Grid Background="#FFF8F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFF8F0F0" BorderThickness="0,0,0,1" BorderBrush="#FFE0E0E0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                    <Icon:PackIconMaterial Kind="TruckDelivery" Width="30" Height="30" Foreground="#FF920C0C" VerticalAlignment="Center"/>
                    <TextBlock Text="Поставщики" FontSize="28" FontWeight="Bold" Foreground="#FF920C0C" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="txtSearch" Style="{StaticResource ModernSearchBox}" HorizontalAlignment="Left" TextChanged="txtSearch_TextChanged"/>
                <TextBlock Text="Поиск..." Margin="45,0,0,0" VerticalAlignment="Center" Foreground="#FF6C879A" IsHitTestVisible="False" Visibility="{Binding ElementName=txtSearch, Path=Text.IsEmpty, Converter={StaticResource BoolToVis}}"/>
                <Icon:PackIconMaterial Kind="Magnify" Width="20" Height="20" Foreground="#FF6C879A" Margin="15,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <Button x:Name="AddBtn" Grid.Column="1" Content="Добавить" Style="{StaticResource ModernButton}" Click="AddBtn_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFD73636" Offset="0"/>
                        <GradientStop Color="#FF920C0C" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource ModernBorder}" Background="White" Margin="20,0">
            <DataGrid Name="DG" AutoGenerateColumns="False" IsReadOnly="True" Loaded="DG_Loaded" Style="{DynamicResource DataGridStyle1}" CellStyle="{DynamicResource DataGridCellStyle1}" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" RowStyle="{DynamicResource DataGridRowStyle1}" Margin="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding SupplierID}" Width="60" Visibility="Hidden"/>
                    <DataGridTextColumn Header="Название поставщика" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding EmailSupplier}" Width="*"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNum}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,20">
            <Button x:Name="DeteleBtn" Content="Удалить" Style="{StaticResource ModernButton}" Background="#FF920C0C" Click="DeteleBtn_Click"/>
            <Button x:Name="EditBtn" Content="Изменить" Style="{StaticResource ModernButton}" Click="EditBtn_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFD73636" Offset="0"/>
                        <GradientStop Color="#FF920C0C" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>
    </Grid>
</Page>