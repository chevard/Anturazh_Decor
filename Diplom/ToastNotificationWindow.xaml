<Window x:Class="Diplom.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Toast Notification" 
        Height="80" 
        Width="350" 
        Topmost="True" 
        WindowStyle="None" 
        ShowInTaskbar="False" 
        AllowsTransparency="True" 
        Background="Transparent">

    <Border Background="#FF920C0C" CornerRadius="15" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Color="#66000000"/>
        </Border.Effect>
        <Grid Margin="15,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Icon:PackIconMaterial Kind="Bell" Width="20" Height="20" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock x:Name="NotificationText" Grid.Column="1" VerticalAlignment="Center" Margin="15,0" TextWrapping="Wrap" Foreground="White" FontSize="14" FontWeight="Medium"/>
            <Button Grid.Column="2" Style="{StaticResource CloseButton}" Click="Button_Click" VerticalAlignment="Top" HorizontalAlignment="Right">
                <Icon:PackIconMaterial Kind="Close" Width="12" Height="12" Foreground="White"/>
            </Button>
        </Grid>
    </Border>
</Window>