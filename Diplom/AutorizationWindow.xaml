<Window x:Class="Diplom.AutorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Авторизация" 
        Height="500" 
        Width="500"
        Background="Transparent" 
        AllowsTransparency="True" 
        WindowStyle="None" 
        WindowStartupLocation="CenterScreen">

    <Border Background="#4A0E0E" CornerRadius="30" BorderThickness="2" BorderBrush="#8B0000">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Button HorizontalAlignment="Right" Width="30" Height="30" Style="{StaticResource LoginButton}" Background="#FF920C0C" Click="CloseButton_Click">
                    <Icon:PackIconMaterial Kind="Close" Width="20" Height="20"/>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Icon:PackIconMaterial Kind="Account" Width="80" Height="80" Foreground="#FFD73636" HorizontalAlignment="Center" Margin="0,24,0,10"/>
                <TextBlock Text="Авторизация" FontSize="32" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="0,0,0,20"/>
                <Grid>
                    <TextBox Name="UsernameTextBox" Style="{StaticResource AutorizTB}"/>
                    <Icon:PackIconMaterial Kind="Account" Width="22" Height="22" Foreground="#FF920C0C" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Grid>
                    <PasswordBox Name="PasswordBox" Style="{StaticResource ModernPasswordBox}"/>
                    <Icon:PackIconMaterial Kind="Lock" Width="22" Height="22" Foreground="#FF920C0C" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Button Name="LoginButton" Content="ВОЙТИ" Style="{StaticResource LoginButton}" Click="LoginButton_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFD73636" Offset="0"/>
                            <GradientStop Color="#FF920C0C" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="© 2025 Все права защищены" Foreground="#FFB22A2A" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>