<Window x:Class="Diplom.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Добавить/Изменить товар" 
        Height="600" 
        Width="500"
        Background="Transparent" 
        WindowStyle="None" 
        WindowStartupLocation="CenterScreen">

    <Border Background="#4A0E0E" CornerRadius="30" BorderThickness="2" BorderBrush="#8B0000">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FF920C0C" CornerRadius="20" Margin="0,0,0,20">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Icon:PackIconMaterial Kind="Package" Width="30" Height="30" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Добавить/изменить товар" FontSize="20" FontWeight="Bold" Foreground="White" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Name="CloseButton" Width="30" Height="30" Style="{StaticResource ModernButton}" Click="CancelButton_Click">
                        <Icon:PackIconMaterial Kind="Close" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="#FFF8F0F0" CornerRadius="20" Margin="0,10">
                <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Название товара" Foreground="#FF920C0C" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                        <Grid>
                            <TextBox Name="ProductNamTB" Text="{Binding ProductName}" Style="{StaticResource ModernTextBox}"/>
                            <Icon:PackIconMaterial Kind="Package" Width="18" Height="18" Foreground="#FF920C0C" Margin="10,0,0,10" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Категория" Foreground="#FF920C0C" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                        <Grid>
                            <ComboBox Name="CategoryCB" Style="{StaticResource ModernComboBox}" DisplayMemberPath="CategoryName" SelectedValue="{Binding CategoryID}" SelectedValuePath="CategoryID"/>
                            <Icon:PackIconMaterial Kind="Tag" Width="18" Height="18" Foreground="#FF920C0C" Margin="10,0,0,10" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Поставщик" Foreground="#FF920C0C" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                        <Grid>
                            <ComboBox Name="SupplierCB" Style="{StaticResource ModernComboBox}" DisplayMemberPath="SupplierName" SelectedValue="{Binding SupplierID}" SelectedValuePath="SupplierID"/>
                            <Icon:PackIconMaterial Kind="Truck" Width="18" Height="18" Foreground="#FF920C0C" Margin="10,0,0,10" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Цена" Foreground="#FF920C0C" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                        <Grid>
                            <TextBox Name="PriceTB" Text="{Binding Price}" Style="{StaticResource ModernTextBox}"/>
                            <Icon:PackIconMaterial Kind="CurrencyRub" Width="18" Height="18" Foreground="#FF920C0C" Margin="10,0,0,10" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Количество" Foreground="#FF920C0C" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                        <Grid>
                            <TextBox Name="QuantityTB" Text="{Binding StockQuantity}" Style="{StaticResource ModernTextBox}"/>
                            <Icon:PackIconMaterial Kind="Counter" Width="18" Height="18" Foreground="#FF920C0C" Margin="10,0,0,10" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Name="SaveButton" Content="Сохранить" Style="{StaticResource ModernButton}" Click="SaveButton_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFD73636" Offset="0"/>
                            <GradientStop Color="#FF920C0C" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
                <Button Name="CancelButton" Content="Отмена" Style="{StaticResource ModernButton}" Background="#FF920C0C" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>